# Host-side AIO administration endpoint (HTTPS with a self-signed certificate).
AIO_BIND_IP=127.0.0.1
AIO_PORT=18080

# HTTP backend published by AIO's Apache container, not the master container.
# Keep loopback binding when Tailscale runs directly on the Docker host.
APACHE_IP_BINDING=127.0.0.1
APACHE_PORT=11000

# Private Tailscale hostname: bypass the public-domain reachability check.
# This does not configure DNS, HTTPS or connectivity for the containers.
SKIP_DOMAIN_VALIDATION=true
